---
import { getDocumentation } from '../../lib/docs.mjs';

export async function getStaticPaths() {
  const pages = await getDocumentation();
  return pages.map((page) => ({ params: { slug: page.slug || undefined }, props: { page, pages } }));
}

const { page, pages } = Astro.props;
const sections = [
  { label: 'Start here', items: pages.filter((item) => item.source === 'docs/index.mdx' || item.source === 'docs/architecture.mdx') },
  { label: 'Getting started', items: pages.filter((item) => item.source.startsWith('docs/getting-started/')) },
  { label: 'Guides', items: pages.filter((item) => item.source.startsWith('docs/guides/')) },
  { label: 'Reference', items: pages.filter((item) => item.source.startsWith('docs/reference/')) },
  { label: 'Repository', items: pages.filter((item) => !item.source.startsWith('docs/')) },
];
const section = sections.find((group) => group.items.some((item) => item.source === page.source));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={page.description || `Documentation for ${page.title}.`} />
    <meta name="theme-color" content="#f5f4ee" />
    <link rel="icon" type="image/svg+xml" href="/koamishin-logo.svg" />
    <title>{page.title} | Koamishin documentation</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="header shell">
      <a class="brand" href="/"><img src="/koamishin-logo.svg" alt="" width="36" height="36" /><span>koamishin<span class="brand-light"> / portal</span></span></a>
      <nav aria-label="Main navigation"><a href="/">Home</a><a class="current" href="/docs/" aria-current="page">Documentation <span aria-hidden="true">↗</span></a></nav>
    </header>
    <div class="shell layout">
      <aside class="sidebar">
        <nav class="desktop-nav" aria-label="Documentation navigation">
          {sections.map((group) => <div class="nav-group"><p>{group.label}</p>{group.items.map((item) => <a href={item.url} aria-current={item.source === page.source ? 'page' : undefined}>{item.title}</a>)}</div>)}
        </nav>
        <details class="mobile-nav"><summary>Browse documentation <span aria-hidden="true">↓</span></summary>
          <nav aria-label="Documentation navigation">
            {sections.map((group) => <div class="nav-group"><p>{group.label}</p>{group.items.map((item) => <a href={item.url} aria-current={item.source === page.source ? 'page' : undefined}>{item.title}</a>)}</div>)}
          </nav>
        </details>
      </aside>
      <main id="main" class="main">
        <div class="breadcrumb"><a href="/docs/">Documentation</a><span aria-hidden="true"> / </span><span>{section?.label}</span></div>
        <article class="prose" set:html={page.html} />
        <div class="page-end"><span>KOAMISHIN / DOCUMENTATION</span><a href="#main">Back to top ↑</a></div>
      </main>
    </div>
    <footer class="footer shell"><span>Account access, thoughtfully connected.</span><a href="/">Back to the portal home ↗</a></footer>
  </body>
</html>
<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap');
  :root{font-family:Manrope,sans-serif;color:#20241f;background:#f5f4ee;font-synthesis:none;scroll-behavior:smooth}*{box-sizing:border-box}body{margin:0}a{color:inherit}a:focus-visible,summary:focus-visible{outline:3px solid #c85d36;outline-offset:4px}.shell{width:min(100% - 64px,1280px);margin-inline:auto}.skip{position:absolute;left:16px;top:-80px;background:#fff;padding:12px;z-index:10}.skip:focus{top:16px}.header{height:96px;display:flex;align-items:center;justify-content:space-between;gap:24px;border-bottom:1px solid #d2d5ca}.brand{display:inline-flex;align-items:center;gap:12px;text-decoration:none;font-size:16px;font-weight:700;letter-spacing:-.04em}.brand img{border-radius:8px}.brand-light{font-weight:400;color:#777c72}.header nav{display:flex;align-items:center;gap:32px;font-size:14px;font-weight:600}.header nav a{text-decoration:none}.header .current{border:1px solid #c7cbc0;border-radius:999px;padding:12px 16px}.current span{margin-left:16px}.layout{display:grid;grid-template-columns:240px minmax(0,1fr);gap:64px}.sidebar{padding:48px 0}.mobile-nav{display:none}.nav-group{margin-bottom:32px}.nav-group p{margin:0 0 12px;color:#788173;font-size:12px;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.nav-group a{display:block;padding:8px 12px;margin-left:-12px;border-radius:8px;text-decoration:none;color:#586256;font-size:14px;line-height:1.45}.nav-group a:hover{background:#e8ebe3}.nav-group a[aria-current=page]{background:#dce4d6;color:#263b29;font-weight:700}.main{min-width:0;max-width:850px;padding:48px 0 80px}.breadcrumb{font-size:12px;font-weight:700;color:#788173;margin-bottom:32px}.breadcrumb a{text-decoration:none}.prose{font-size:16px;line-height:1.75;overflow-wrap:anywhere}.prose h1,.prose h2,.prose h3{line-height:1.2;letter-spacing:-.04em;text-wrap:balance}.prose h1{font-size:clamp(36px,4vw,56px);margin:0 0 32px}.prose h2{font-size:26px;margin:48px 0 16px}.prose h3{font-size:20px;margin:32px 0 12px}.prose p,.prose ul,.prose ol{margin:0 0 20px}.prose a{color:#385d3e;text-decoration-thickness:1px;text-underline-offset:3px}.prose a:hover{color:#c15430}.prose code{font-family:ui-monospace,monospace;font-size:.875em;background:#e6eae1;padding:2px 4px;border-radius:4px}.prose pre{overflow:auto;padding:24px;border-radius:8px;margin:24px 0;background:#242d25!important;color:#f5f4ee}.prose pre code{background:none;padding:0;font-size:14px;overflow-wrap:normal}.prose table{display:block;overflow:auto;border-collapse:collapse;margin:24px 0}.prose th,.prose td{padding:12px;border:1px solid #d2d5ca;text-align:left;vertical-align:top}.prose blockquote{margin:24px 0;padding:16px 24px;background:#e6ebe2;border-radius:8px}.prose blockquote p:last-child{margin:0}.page-end{display:flex;justify-content:space-between;gap:24px;border-top:1px solid #d2d5ca;margin-top:64px;padding-top:24px;font-size:12px;font-weight:700;color:#788173}.page-end a{color:#434b40;text-decoration:none}.footer{display:flex;justify-content:space-between;gap:24px;border-top:1px solid #d2d5ca;padding:32px 0 48px;font-size:12px;color:#7e857a}.footer a{color:#434b40;font-weight:700;text-decoration:none}@media(max-width:800px){.shell{width:min(100% - 40px,1280px)}.header{height:80px}.header nav{gap:16px}.header nav>a:first-child{display:none}.layout{display:block}.sidebar{padding:24px 0 0}.desktop-nav{display:none}.mobile-nav{display:block;border:1px solid #c7cbc0;border-radius:8px}.mobile-nav>summary{display:flex;justify-content:space-between;cursor:pointer;padding:16px;font-size:14px;font-weight:700}.mobile-nav nav{padding:8px 24px 0}.main{padding:32px 0 64px}.footer{flex-direction:column}.prose h1{font-size:36px}}@media(prefers-reduced-motion:reduce){:root{scroll-behavior:auto}}
</style>
